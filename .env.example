# All optional — the bot runs keyless using public Bybit REST + rule-based fallbacks.
# Fill these in only to enable the corresponding enhancement layer.

# AI trend classifier (Gemini). Without it, the EMA/ADX rule classifier is used.
GEMINI_API_KEY=

# Telegram alerts. Without these, signals print to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis cache. Without it, an in-process cache is used.
REDIS_URL=

# Postgres persistence (Drizzle ORM). Without it, metrics/signals are not persisted.
DATABASE_URL=

# Bybit market category: linear (USDT perps) | spot
BYBIT_CATEGORY=linear

# ── Health & monitoring (loop mode only) ──────────────────────────────────────
# Health endpoint port. Set to 0 to disable the health server. Bound to
# HEALTH_HOST (loopback by default — reach it via SSH tunnel or a reverse proxy).
HEALTH_PORT=3000
HEALTH_HOST=127.0.0.1

# Startup/shutdown/crash alerts via the notifier (Telegram if configured, else
# console). Set to false to silence them.
OPS_ALERTS=true
